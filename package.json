{
	"name": "library",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types",
		"sync": "node scripts/data.mjs",
		"fill": "node scripts/fill.mjs",
		"add": "node scripts/add.mjs",
		"isbn-fixes": "node scripts/isbn-fixes.mjs",
		"tags": "node scripts/tag-plan.mjs",
		"sizes": "node scripts/sizes.mjs"
	},
	"devDependencies": {
		"@fontsource/bricolage-grotesque": "^5.3.0",
		"@fontsource/crimson-pro": "^5.3.0",
		"@fontsource/eb-garamond": "^5.3.0",
		"@fontsource/fraunces": "^5.3.0",
		"@fontsource/gentium-book-plus": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@fontsource/league-gothic": "^5.3.0",
		"@fontsource/libre-franklin": "^5.3.0",
		"@fontsource/newsreader": "^5.3.0",
		"@fontsource/space-mono": "^5.3.0",
		"@fontsource/work-sans": "^5.3.0",
		"@fontsource/young-serif": "^5.3.0",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"wrangler": "^4.162.0"
	}
}
